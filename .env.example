# Copia a .env (local) o configura en Cloudflare (Pages/Workers → env vars).
# Solo variables PUBLIC_ llegan al cliente. Todas son opcionales.

# Cloudflare Web Analytics (sin cookies). Token del beacon de tu dashboard.
# Si está vacío, no se inyecta el script.
PUBLIC_CF_BEACON_TOKEN=

# Newsletter: endpoint del proveedor al que se postea el correo (form-encoded, campo "email").
# Ej. Buttondown: https://buttondown.com/api/emails/embed-subscribe/<usuario>
# Ej. Formspree:  https://formspree.io/f/<id>
# Si está vacío, el form cae a "escríbeme por correo".
PUBLIC_NEWSLETTER_ENDPOINT=
