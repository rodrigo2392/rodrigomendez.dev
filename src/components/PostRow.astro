---
import type { Post } from '../lib/blog';
import { formatDate, isoDate, readingMinutes, postUrl } from '../lib/blog';

interface Props {
  post: Post;
  thumb?: boolean;
}
const { post, thumb = false } = Astro.props;
const { title, description, pubDate, tags, heroImage, readingTime } = post.data;
const min = readingMinutes(post.body, readingTime);
---
<a class:list={['row', { 'row--thumb': thumb }]} href={postUrl(post)}>
  <div class="row__main">
    <p class="meta">
      <time datetime={isoDate(pubDate)}>{formatDate(pubDate)}</time>
      <span aria-hidden="true">·</span> {min} min
      <span aria-hidden="true">·</span> <span class="tag">{tags[0]}</span>
    </p>
    <h3 class="row__title">{title}</h3>
    <p class="row__excerpt">{description}</p>
  </div>
  {
    thumb && (
      <div class="row__thumb">
        {heroImage ? (
          <img src={heroImage} alt="" loading="lazy" />
        ) : (
          <div class="placeholder-stripes row__ph" />
        )}
      </div>
    )
  }
</a>

<style>
  .row {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.5rem;
    align-items: center;
    padding: 2rem 0;
    border-top: 1px solid var(--color-border);
  }
  .row--thumb {
    grid-template-columns: 1fr 180px;
  }
  .row__title {
    font-size: 1.85rem;
    font-weight: 700;
    letter-spacing: -0.01em;
    line-height: 1.15;
    margin: 0.8rem 0 0.6rem;
    transition: color 0.15s ease;
  }
  .row:hover .row__title {
    color: var(--color-accent);
  }
  .row__excerpt {
    color: var(--color-muted);
    font-size: 1.08rem;
    max-width: 64ch;
  }
  .row__thumb {
    align-self: stretch;
  }
  .row__thumb img,
  .row__ph {
    width: 100%;
    height: 100%;
    min-height: 120px;
    border-radius: 12px;
    object-fit: cover;
  }
  @media (max-width: 40rem) {
    .row--thumb {
      grid-template-columns: 1fr;
    }
    .row__thumb {
      display: none;
    }
    .row__title {
      font-size: 1.35rem;
    }
  }
</style>
