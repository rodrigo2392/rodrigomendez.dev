---
// Code-card estático del hero (rodrigo.ts). Estilo editor, no ejecuta nada.
const lines = [
  { c: [{ t: "// un poco sobre mí", k: "com" }] },
  { c: [{ t: "const ", k: "kw" }, { t: "rodrigo ", k: "var" }, { t: "= {", k: "pun" }] },
  { c: [{ t: "  rol", k: "key" }, { t: ": ", k: "pun" }, { t: "'Fullstack Product Developer'", k: "str" }, { t: ",", k: "pun" }] },
  { c: [{ t: "  base", k: "key" }, { t: ": ", k: "pun" }, { t: "'Guadalajara, MX'", k: "str" }, { t: ",", k: "pun" }] },
  { c: [{ t: "  experiencia", k: "key" }, { t: ": ", k: "pun" }, { t: "11", k: "num" }, { t: ",", k: "pun" }] },
  { c: [{ t: "  construyendo", k: "key" }, { t: ": ", k: "pun" }, { t: "'Piclink'", k: "str" }, { t: ",", k: "pun" }] },
  { c: [{ t: "  comparte", k: "key" }, { t: ": ", k: "pun" }, { t: "'lo que aprende'", k: "str" }, { t: ",", k: "pun" }] },
  { c: [{ t: "}", k: "pun" }] },
];
---
<div class="cc cc-type" data-typewriter role="img" aria-label="Perfil de Rodrigo en formato de objeto de código">
  <div class="cc__bar">
    <span class="cc__dots"><i></i><i></i><i></i></span>
    <span class="cc__file">rodrigo.ts</span>
  </div>
  <pre class="cc__code"><code>{lines.map((line, i) => (
    <span class="cc__line"><span class="cc__ln">{i + 1}</span><span class="cc__content">{line.c.map((s) => (<span class={`tok tok--${s.k}`}>{s.t.split('').map((ch) => (<span class="ch">{ch}</span>))}</span>))}</span></span>
  ))}</code></pre>
</div>

<script>
  const card = document.querySelector('[data-typewriter]');
  if (card) {
    const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
    const lines = Array.from(card.querySelectorAll('.cc__line'));
    const seq: { ch: Element; num: Element | null }[] = [];
    for (const line of lines) {
      const num = line.querySelector('.cc__ln');
      const chs = Array.from(line.querySelectorAll('.ch'));
      chs.forEach((ch, idx) => seq.push({ ch, num: idx === 0 ? num : null }));
    }
    const revealAll = () => {
      seq.forEach(({ ch, num }) => {
        ch.classList.add('is-on');
        num?.classList.add('is-on');
      });
      seq[seq.length - 1]?.ch.classList.add('caret');
    };
    if (reduce || !seq.length) {
      revealAll();
    } else {
      let i = 0;
      let prev: Element | null = null;
      const step = () => {
        if (prev) prev.classList.remove('caret');
        if (i >= seq.length) {
          seq[seq.length - 1].ch.classList.add('caret');
          return;
        }
        const { ch, num } = seq[i++];
        num?.classList.add('is-on');
        ch.classList.add('is-on', 'caret');
        prev = ch;
        const c = ch.textContent;
        const base = c === ' ' ? 8 : 14 + Math.random() * 34;
        setTimeout(step, num ? base + 80 : base);
      };
      const io = new IntersectionObserver((entries, obs) => {
        if (entries[0].isIntersecting) {
          obs.disconnect();
          setTimeout(step, 400);
        }
      }, { threshold: 0.25 });
      io.observe(card);
    }
  }
</script>

<style>
  .cc {
    min-width: 0;
    max-width: 100%;
    border: 1px solid var(--color-border);
    border-radius: 14px;
    background: var(--color-surface);
    overflow: hidden;
    box-shadow: 0 20px 60px -30px rgba(0, 0, 0, 0.8);
  }
  .cc__bar {
    display: flex;
    align-items: center;
    gap: 0.9rem;
    padding: 0.75rem 1.1rem;
    border-bottom: 1px solid var(--color-border);
  }
  .cc__dots {
    display: inline-flex;
    gap: 7px;
  }
  .cc__dots i {
    width: 11px;
    height: 11px;
    border-radius: 999px;
    background: #2a3342;
    display: block;
  }
  .cc__file {
    font-family: var(--font-mono);
    font-size: 0.85rem;
    color: var(--color-muted);
  }
  .cc__code {
    margin: 0;
    padding: 1.1rem 1.1rem 1.3rem;
    font-family: var(--font-mono);
    font-size: 0.92rem;
    line-height: 1.9;
    overflow-x: auto;
  }
  .cc__line {
    display: flex;
    gap: 1.4rem;
    white-space: pre;
  }
  .cc__ln {
    color: #3a4556;
    width: 1ch;
    text-align: right;
    user-select: none;
    flex-shrink: 0;
  }
  .tok--com { color: var(--color-faint); }
  .tok--kw  { color: var(--color-accent); }
  .tok--var { color: var(--color-ink); }
  .tok--key { color: #8fb8c9; }
  .tok--str { color: #98c8b0; }
  .tok--num { color: #e0b070; }
  .tok--pun { color: var(--color-muted); }
</style>
