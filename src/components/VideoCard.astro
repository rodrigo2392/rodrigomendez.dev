---
interface Props {
  title: string;
  duration?: string | null;
  url: string;
  thumb?: string | null;
  description?: string | null;
  delayMs?: number;
}
const { title, duration, url, thumb, description, delayMs = 0 } = Astro.props;
---
<a class="vcard" href={url} target="_blank" rel="noopener" style={`--d:${delayMs}ms`}>
  <div class="vcard__thumb placeholder-stripes">
    {thumb && <img src={thumb} alt="" loading="lazy" />}
    <span class="vcard__play" aria-hidden="true">
      <svg viewBox="0 0 24 24" width="20" height="20"><path d="M8 5v14l11-7z" fill="currentColor"/></svg>
    </span>
    {duration && <span class="vcard__dur">{duration}</span>}
  </div>
  <h3 class="vcard__title">{title}</h3>
  {description && <p class="vcard__desc">{description}</p>}
</a>

<style>
  .vcard {
    display: block;
  }
  .vcard__thumb {
    position: relative;
    aspect-ratio: 16 / 10;
    border-radius: 12px;
    overflow: hidden;
    display: grid;
    place-items: center;
  }
  .vcard__thumb img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .vcard__play {
    position: relative;
    display: grid;
    place-items: center;
    width: 52px;
    height: 52px;
    border-radius: 999px;
    border: 1px solid var(--color-accent);
    color: var(--color-accent);
    background: color-mix(in srgb, var(--color-accent) 8%, transparent);
    transition: transform 0.15s ease, background 0.15s ease;
  }
  .vcard:hover .vcard__play {
    transform: scale(1.08);
    background: color-mix(in srgb, var(--color-accent) 16%, transparent);
  }
  .vcard__dur {
    position: absolute;
    right: 0.6rem;
    bottom: 0.6rem;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    padding: 0.15rem 0.45rem;
    border-radius: 5px;
    background: rgba(0, 0, 0, 0.6);
    color: var(--color-ink);
  }
  .vcard__title {
    font-size: 1.18rem;
    font-weight: 600;
    margin-top: 0.9rem;
    line-height: 1.3;
    transition: color 0.15s ease;
  }
  .vcard:hover .vcard__title {
    color: var(--color-accent);
  }
  .vcard__desc {
    margin-top: 0.5rem;
    font-size: 0.98rem;
    color: var(--color-muted);
    line-height: 1.5;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
</style>
