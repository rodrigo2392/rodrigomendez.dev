---
import { getPublishedPosts, postUrl } from '../lib/blog';
import { SOCIALS } from '../consts';

const posts = await getPublishedPosts();
const items = [
  { label: 'Inicio', href: '/', hint: 'inicio.tsx', kind: 'nav' },
  { label: 'Sobre mí', href: '/#sobre', hint: 'sobre.md', kind: 'nav' },
  { label: 'Proyectos', href: '/proyectos', hint: 'proyectos/', kind: 'nav' },
  { label: 'Demos', href: '/demos', hint: 'demos/', kind: 'nav' },
  { label: 'Blog', href: '/blog', hint: 'blog/', kind: 'nav' },
  { label: 'Videos', href: '/#videos', hint: 'videos/', kind: 'nav' },
  { label: 'Uses', href: '/uses', hint: 'uses', kind: 'nav' },
  { label: 'Contacto', href: '/#contacto', hint: 'contacto', kind: 'nav' },
  ...posts.map((p) => ({ label: p.data.title, href: postUrl(p), hint: p.data.tags[0], kind: 'post' })),
  { label: 'YouTube', href: SOCIALS.youtube, hint: '↗', kind: 'ext' },
  { label: 'GitHub', href: SOCIALS.github, hint: '↗', kind: 'ext' },
];
---
<div class="cmdk" data-cmdk hidden>
  <div class="cmdk__backdrop" data-cmdk-close></div>
  <div class="cmdk__panel" role="dialog" aria-modal="true" aria-label="Navegación rápida">
    <div class="cmdk__search">
      <span class="cmdk__prompt" aria-hidden="true">›</span>
      <input
        type="text"
        class="cmdk__input"
        data-cmdk-input
        placeholder="Ir a… escribe para filtrar"
        aria-label="Buscar"
        autocomplete="off"
        spellcheck="false"
      />
      <kbd class="cmdk__esc">esc</kbd>
    </div>
    <ul class="cmdk__list" data-cmdk-list role="listbox">
      {
        items.map((it) => (
          <li>
            <a
              class="cmdk__item"
              href={it.href}
              data-cmdk-item
              data-label={it.label.toLowerCase()}
              data-hint={it.hint.toLowerCase()}
              target={it.kind === 'ext' ? '_blank' : undefined}
              rel={it.kind === 'ext' ? 'noopener' : undefined}
            >
              <span class="cmdk__kind" data-kind={it.kind} aria-hidden="true" />
              <span class="cmdk__label">{it.label}</span>
              <span class="cmdk__hint">{it.hint}</span>
            </a>
          </li>
        ))
      }
    </ul>
    <p class="cmdk__empty" data-cmdk-empty hidden>sin resultados</p>
  </div>
</div>

<script>
  const root = document.querySelector('[data-cmdk]') as HTMLElement | null;
  if (root && !root.dataset.bound) {
    root.dataset.bound = '1';
    const input = root.querySelector('[data-cmdk-input]') as HTMLInputElement;
    const list = root.querySelector('[data-cmdk-list]') as HTMLElement;
    const empty = root.querySelector('[data-cmdk-empty]') as HTMLElement;
    const items = Array.from(root.querySelectorAll('[data-cmdk-item]')) as HTMLAnchorElement[];
    let active = 0;

    const visible = () => items.filter((el) => !el.parentElement!.hidden);

    const setActive = (i: number) => {
      const vis = visible();
      if (!vis.length) return;
      active = (i + vis.length) % vis.length;
      items.forEach((el) => el.classList.remove('is-active'));
      vis[active].classList.add('is-active');
      vis[active].scrollIntoView({ block: 'nearest' });
    };

    const filter = () => {
      const q = input.value.trim().toLowerCase();
      let count = 0;
      for (const el of items) {
        const hit = !q || el.dataset.label!.includes(q) || el.dataset.hint!.includes(q);
        el.parentElement!.hidden = !hit;
        if (hit) count++;
      }
      empty.hidden = count > 0;
      active = 0;
      setActive(0);
    };

    const open = () => {
      root.hidden = false;
      requestAnimationFrame(() => root.classList.add('is-open'));
      input.value = '';
      filter();
      input.focus();
      document.documentElement.style.overflow = 'hidden';
    };
    const close = () => {
      root.classList.remove('is-open');
      document.documentElement.style.overflow = '';
      setTimeout(() => { root.hidden = true; }, 180);
    };
    const toggle = () => (root.hidden ? open() : close());

    document.addEventListener('keydown', (e) => {
      const inField = (e.target as HTMLElement)?.matches?.('input,textarea');
      if ((e.key === 'k' || e.key === 'K') && (e.metaKey || e.ctrlKey)) {
        e.preventDefault();
        toggle();
        return;
      }
      if (e.key === '/' && !inField && root.hidden) {
        e.preventDefault();
        open();
        return;
      }
      if (root.hidden) return;
      if (e.key === 'Escape') { e.preventDefault(); close(); }
      else if (e.key === 'ArrowDown') { e.preventDefault(); setActive(active + 1); }
      else if (e.key === 'ArrowUp') { e.preventDefault(); setActive(active - 1); }
      else if (e.key === 'Enter') {
        const vis = visible();
        if (vis[active]) { e.preventDefault(); vis[active].click(); }
      }
    });

    input.addEventListener('input', filter);
    root.querySelector('[data-cmdk-close]')?.addEventListener('click', close);
    items.forEach((el, i) =>
      el.addEventListener('mousemove', () => {
        const vis = visible();
        const idx = vis.indexOf(el);
        if (idx >= 0 && idx !== active) setActive(idx);
      })
    );
    // Cerrar al navegar (por si el destino es la misma página con hash).
    document.addEventListener('astro:page-load', () => { if (!root.hidden) close(); });
  }
</script>

<style>
  .cmdk {
    position: fixed;
    inset: 0;
    z-index: 100;
    display: grid;
    justify-items: center;
    align-items: start;
    padding-top: 14vh;
  }
  .cmdk[hidden] { display: none; }
  .cmdk__backdrop {
    position: absolute;
    inset: 0;
    background: rgba(4, 7, 12, 0.62);
    backdrop-filter: blur(3px);
    opacity: 0;
    transition: opacity 0.18s ease;
  }
  .cmdk.is-open .cmdk__backdrop { opacity: 1; }
  .cmdk__panel {
    position: relative;
    width: min(40rem, calc(100vw - 2rem));
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: 14px;
    box-shadow: 0 30px 80px -30px rgba(0, 0, 0, 0.9);
    overflow: hidden;
    transform: translateY(-8px) scale(0.98);
    opacity: 0;
    transition: transform 0.18s ease, opacity 0.18s ease;
  }
  .cmdk.is-open .cmdk__panel { transform: none; opacity: 1; }
  .cmdk__search {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 0.9rem 1.1rem;
    border-bottom: 1px solid var(--color-border);
  }
  .cmdk__prompt { color: var(--color-accent); font-family: var(--font-mono); }
  .cmdk__input {
    flex: 1;
    background: none;
    border: none;
    outline: none;
    color: var(--color-ink);
    font-family: var(--font-sans);
    font-size: 1.05rem;
  }
  .cmdk__input::placeholder { color: var(--color-faint); }
  .cmdk__esc {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    color: var(--color-muted);
    border: 1px solid var(--color-border);
    border-radius: 5px;
    padding: 0.1rem 0.4rem;
  }
  .cmdk__list {
    list-style: none;
    margin: 0;
    padding: 0.4rem;
    max-height: min(24rem, 56vh);
    overflow-y: auto;
  }
  .cmdk__item {
    display: flex;
    align-items: center;
    gap: 0.8rem;
    padding: 0.6rem 0.75rem;
    border-radius: 9px;
    color: var(--color-ink);
  }
  .cmdk__item.is-active {
    background: var(--color-accent-soft);
  }
  .cmdk__kind {
    width: 7px; height: 7px; border-radius: 999px;
    background: var(--color-faint); flex-shrink: 0;
  }
  .cmdk__kind[data-kind='nav'] { background: var(--color-accent); }
  .cmdk__kind[data-kind='post'] { background: #8fb8c9; }
  .cmdk__kind[data-kind='ext'] { background: var(--color-faint); }
  .cmdk__label {
    flex: 1;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .cmdk__item.is-active .cmdk__label { color: var(--color-accent); }
  .cmdk__hint {
    font-family: var(--font-mono);
    font-size: 0.78rem;
    color: var(--color-muted);
    flex-shrink: 0;
  }
  .cmdk__empty {
    padding: 1.5rem;
    text-align: center;
    color: var(--color-muted);
    font-family: var(--font-mono);
    font-size: 0.9rem;
  }
  @media (prefers-reduced-motion: reduce) {
    .cmdk__backdrop, .cmdk__panel { transition: none; }
  }
</style>
