---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout title="404" description="Página no encontrada.">
  <section class="err container-site">
    <p class="kicker kicker--accent">error 404</p>
    <h1 class="err__title">Esta página no compiló.</h1>

    <div class="err__card">
      <div class="err__bar">
        <span class="err__dots"><i></i><i></i><i></i></span>
        <span class="err__file">error.log</span>
      </div>
      <pre class="err__code"><code>$ open <span class="err__path" data-path>/…</span>

<span class="err__throw">Uncaught Error</span>: 404 — esta página no existe
    at <span class="err__accent">rodrigomendez.dev</span><span class="err__path" data-path>/…</span>
    at Router.resolve (<span class="err__dim">router.ts:42</span>)
    at fetchPage (<span class="err__dim">server.ts:88</span>)

<span class="err__com">// quizá se movió, o nunca existió. Regresemos a terreno conocido.</span></code></pre>
    </div>

    <div class="err__cta">
      <a href="/" class="btn-accent"><span aria-hidden="true">←</span> volver al inicio</a>
      <a href="/blog" class="btn-outline">ver el blog</a>
    </div>
  </section>
</BaseLayout>

<script>
  function setPath() {
    const p = location.pathname + location.search;
    document.querySelectorAll('[data-path]').forEach((el) => (el.textContent = p));
  }
  setPath();
  document.addEventListener('astro:page-load', setPath);
</script>

<style>
  .err {
    padding-block: 5rem 6rem;
    max-width: 52rem;
  }
  .err__title {
    font-size: clamp(2rem, 5vw, 3.2rem);
    font-weight: 700;
    letter-spacing: -0.02em;
    margin: 0.75rem 0 2rem;
  }
  .err__card {
    border: 1px solid var(--color-border);
    border-radius: 14px;
    background: var(--color-surface);
    overflow: hidden;
    box-shadow:
      0 20px 60px -30px rgba(0, 0, 0, 0.8),
      0 0 42px -24px color-mix(in srgb, #e5686f 40%, transparent);
  }
  .err__bar {
    display: flex;
    align-items: center;
    gap: 0.9rem;
    padding: 0.75rem 1.1rem;
    border-bottom: 1px solid var(--color-border);
  }
  .err__dots {
    display: inline-flex;
    gap: 7px;
  }
  .err__dots i {
    width: 11px;
    height: 11px;
    border-radius: 999px;
    background: #2a3342;
    display: block;
  }
  .err__file {
    font-family: var(--font-mono);
    font-size: 0.85rem;
    color: var(--color-muted);
  }
  .err__code {
    margin: 0;
    padding: 1.3rem 1.3rem 1.5rem;
    font-family: var(--font-mono);
    font-size: 0.95rem;
    line-height: 1.9;
    color: var(--color-muted);
    overflow-x: auto;
    font-variant-ligatures: none;
  }
  .err__throw {
    color: #e5686f;
    font-weight: 700;
  }
  .err__accent {
    color: var(--color-accent);
  }
  .err__path {
    color: var(--color-ink);
  }
  .err__dim {
    color: var(--color-faint);
  }
  .err__com {
    color: var(--color-faint);
  }
  .err__cta {
    display: flex;
    gap: 1rem;
    flex-wrap: wrap;
    margin-top: 2rem;
  }
</style>
