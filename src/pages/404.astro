---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout title="404" description="Página no encontrada.">
  <section class="err container-site">
    <p class="kicker kicker--accent">error 404</p>
    <h1 class="err__title">Esta página no compiló.</h1>

    <div class="err__card">
      <div class="err__bar">
        <span class="err__dots"><i></i><i></i><i></i></span>
        <span class="err__file">error.log</span>
      </div>
      <pre class="err__code"><code>$ open <span class="err__path" data-path>/…</span>

<span class="err__throw">Uncaught Error</span>: 404 — esta página no existe
    at <span class="err__accent">rodrigomendez.dev</span><span class="err__path" data-path>/…</span>
    at Router.resolve (<span class="err__dim">router.ts:42</span>)
    at fetchPage (<span class="err__dim">server.ts:88</span>)

<span class="err__com">// quizá se movió, o nunca existió. Regresemos a terreno conocido.</span></code></pre>
      <form class="err__prompt" data-cmd-form>
        <span class="err__ps1" aria-hidden="true">rodrigo@dev:~$</span>
        <input
          class="err__input"
          data-cmd
          type="text"
          autocomplete="off"
          spellcheck="false"
          placeholder="home · blog · videos · help"
          aria-label="Comando"
        />
      </form>
      <p class="err__out" data-cmd-out hidden></p>
    </div>

    <div class="err__cta">
      <a href="/" class="btn-accent"><span aria-hidden="true">←</span> volver al inicio</a>
      <a href="/blog" class="btn-outline">ver el blog</a>
    </div>
  </section>
</BaseLayout>

<script>
  function initErr() {
    const p = location.pathname + location.search;
    document.querySelectorAll('[data-path]').forEach((el) => (el.textContent = p));

    const form = document.querySelector('[data-cmd-form]') as HTMLFormElement | null;
    if (!form || form.dataset.bound) return;
    form.dataset.bound = '1';
    const input = form.querySelector('[data-cmd]') as HTMLInputElement;
    const out = document.querySelector('[data-cmd-out]') as HTMLElement;
    const routes: Record<string, string> = {
      home: '/', inicio: '/', cd: '/', 'cd ~': '/', 'cd /': '/',
      blog: '/blog', 'cd blog': '/blog',
      videos: '/#videos', contacto: '/#contacto', contact: '/#contacto',
    };
    const say = (t: string) => { out.hidden = false; out.textContent = t; };
    form.addEventListener('submit', (e) => {
      e.preventDefault();
      const raw = input.value.trim().toLowerCase();
      input.value = '';
      if (!raw) return;
      if (raw === 'help' || raw === '?') return say("comandos: home · blog · videos · contacto · ls · clear");
      if (raw === 'ls') return say("inicio   sobre   blog/   videos/   contacto");
      if (raw === 'clear' || raw === 'cls') { out.hidden = true; out.textContent = ''; return; }
      const dest = routes[raw];
      if (dest) { say('→ ' + dest); location.assign(dest); return; }
      say(`comando no encontrado: ${raw} — prueba 'help'`);
    });
  }
  initErr();
  document.addEventListener('astro:page-load', initErr);
</script>

<style>
  .err {
    padding-block: 5rem 6rem;
    max-width: 52rem;
  }
  .err__title {
    font-size: clamp(2rem, 5vw, 3.2rem);
    font-weight: 700;
    letter-spacing: -0.02em;
    margin: 0.75rem 0 2rem;
  }
  .err__card {
    border: 1px solid var(--color-border);
    border-radius: 14px;
    background: var(--color-surface);
    overflow: hidden;
    box-shadow:
      0 20px 60px -30px rgba(0, 0, 0, 0.8),
      0 0 42px -24px color-mix(in srgb, #e5686f 40%, transparent);
  }
  .err__bar {
    display: flex;
    align-items: center;
    gap: 0.9rem;
    padding: 0.75rem 1.1rem;
    border-bottom: 1px solid var(--color-border);
  }
  .err__dots {
    display: inline-flex;
    gap: 7px;
  }
  .err__dots i {
    width: 11px;
    height: 11px;
    border-radius: 999px;
    background: #2a3342;
    display: block;
  }
  .err__file {
    font-family: var(--font-mono);
    font-size: 0.85rem;
    color: var(--color-muted);
  }
  .err__code {
    margin: 0;
    padding: 1.3rem 1.3rem 1.5rem;
    font-family: var(--font-mono);
    font-size: 0.95rem;
    line-height: 1.9;
    color: var(--color-muted);
    overflow-x: auto;
    font-variant-ligatures: none;
  }
  .err__throw {
    color: #e5686f;
    font-weight: 700;
  }
  .err__accent {
    color: var(--color-accent);
  }
  .err__path {
    color: var(--color-ink);
  }
  .err__dim {
    color: var(--color-faint);
  }
  .err__com {
    color: var(--color-faint);
  }
  .err__prompt {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    padding: 0.85rem 1.3rem;
    border-top: 1px solid var(--color-border);
    font-family: var(--font-mono);
    font-size: 0.92rem;
  }
  .err__ps1 {
    color: var(--color-accent);
    white-space: nowrap;
  }
  .err__input {
    flex: 1;
    min-width: 0;
    background: none;
    border: none;
    outline: none;
    color: var(--color-ink);
    font-family: var(--font-mono);
    font-size: 0.92rem;
    caret-color: var(--color-accent);
  }
  .err__input::placeholder {
    color: var(--color-faint);
  }
  .err__out {
    font-family: var(--font-mono);
    font-size: 0.85rem;
    color: var(--color-muted);
    margin-top: 0.85rem;
  }
  .err__cta {
    display: flex;
    gap: 1rem;
    flex-wrap: wrap;
    margin-top: 2rem;
  }
</style>
