---
import BaseLayout from '../layouts/BaseLayout.astro';
import { PROJECTS } from '../consts';
---
<BaseLayout
  title="Proyectos"
  description="Los productos que construyo en público: Piclink y Cronowork."
>
  <section class="container-site proyectos">
    <header class="proyectos__head">
      <p class="kicker">proyectos</p>
      <h1 class="proyectos__title">Lo que construyo</h1>
      <p class="proyectos__intro">
        Productos reales, en producción, hechos en público. Aquí es donde pruebo en
        carne propia lo que cuento en el blog y los videos.
      </p>
    </header>

    <div class="proyectos__grid">
      {
        PROJECTS.map((p) => (
          <article class="pcard reveal">
            <div class="pcard__top">
              <h2 class="pcard__name">{p.name}</h2>
              <span class:list={['pcard__status', `pcard__status--${p.accent}`]}>
                <span class="pcard__dot" aria-hidden="true" />
                {p.status}
              </span>
            </div>
            <p class="pcard__tagline">{p.tagline}</p>
            <p class="pcard__desc">{p.description}</p>
            <ul class="pcard__stack">
              {p.stack.map((s) => (
                <li>{s}</li>
              ))}
            </ul>
            <div class="pcard__links">
              <a class="btn-accent" href={p.url} target="_blank" rel="noopener">
                Visitar <span aria-hidden="true">↗</span>
              </a>
              {p.repo && (
                <a class="btn-outline" href={p.repo} target="_blank" rel="noopener">
                  Código
                </a>
              )}
            </div>
          </article>
        ))
      }
    </div>
  </section>
</BaseLayout>

<style>
  .proyectos {
    padding-block: 3.5rem 2rem;
  }
  .proyectos__title {
    font-size: clamp(2.6rem, 6vw, 4rem);
    font-weight: 700;
    letter-spacing: -0.02em;
    margin: 0.5rem 0 1rem;
  }
  .proyectos__intro {
    color: var(--color-muted);
    font-size: 1.25rem;
    max-width: 54ch;
  }
  .proyectos__grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1.5rem;
    margin-top: 3rem;
  }
  .pcard {
    display: flex;
    flex-direction: column;
    padding: 2rem;
    border: 1px solid var(--color-border);
    border-radius: 16px;
    background: color-mix(in srgb, var(--color-surface) 55%, transparent);
    transition: border-color 0.15s ease, transform 0.15s ease;
  }
  .pcard:hover {
    border-color: color-mix(in srgb, var(--color-accent) 30%, var(--color-border));
    transform: translateY(-2px);
  }
  .pcard__top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
  }
  .pcard__name {
    font-size: 1.8rem;
    font-weight: 700;
    letter-spacing: -0.01em;
  }
  .pcard__status {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-family: var(--font-mono);
    font-size: 0.72rem;
    color: var(--color-muted);
    white-space: nowrap;
  }
  .pcard__dot {
    width: 7px;
    height: 7px;
    border-radius: 999px;
    background: var(--color-accent);
    box-shadow: 0 0 8px color-mix(in srgb, var(--color-accent) 70%, transparent);
  }
  .pcard__status--oss .pcard__dot {
    background: #8fb8c9;
    box-shadow: 0 0 8px color-mix(in srgb, #8fb8c9 70%, transparent);
  }
  .pcard__tagline {
    font-family: var(--font-mono);
    font-size: 0.9rem;
    color: var(--color-accent);
    margin-top: 0.6rem;
  }
  .pcard__desc {
    color: var(--color-muted);
    margin-top: 0.9rem;
    line-height: 1.6;
  }
  .pcard__stack {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    list-style: none;
    margin: 1.25rem 0 0;
    padding: 0;
  }
  .pcard__stack li {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    padding: 0.25rem 0.6rem;
    border-radius: 6px;
    border: 1px solid var(--color-border);
    color: var(--color-muted);
  }
  .pcard__links {
    display: flex;
    gap: 0.8rem;
    margin-top: auto;
    padding-top: 1.75rem;
  }
  @media (max-width: 46rem) {
    .proyectos__grid {
      grid-template-columns: 1fr;
    }
  }
</style>
