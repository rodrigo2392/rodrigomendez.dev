---
import BaseLayout from '../layouts/BaseLayout.astro';

const groups = [
  {
    title: 'código',
    items: [
      { name: 'VS Code', note: 'editor de todos los días' },
      { name: 'Claude Code · Opus 4.8', note: 'mi copiloto, como palanca no como muleta' },
      { name: 'Astro + Cloudflare', note: 'este sitio, estático y rápido' },
      { name: 'React · React Native · NestJS', note: 'el stack con el que construyo producto' },
      { name: 'Tailwind', note: 'estilos sin salir del HTML' },
    ],
  },
  {
    title: 'máquina',
    items: [
      { name: 'Intel i9-12900KF', note: 'la bestia que compila y renderiza' },
      { name: 'Refrigeración líquida (AIO)', note: 'para que no se cocine en renders largos' },
    ],
  },
  {
    title: 'cámara y video',
    items: [
      { name: 'Sony FX30 · S-Log3', note: 'talking head cinematográfico' },
      { name: 'DaVinci Resolve', note: 'edición y color' },
      { name: 'Remotion', note: 'motion graphics con código (React)' },
      { name: 'Epidemic Sound', note: 'música dark-tech + lofi' },
    ],
  },
  {
    title: 'lo que construyo',
    items: [
      { name: 'Piclink', note: 'SaaS para fotógrafos (en producción)' },
      { name: 'Cronowork', note: 'mi propio Jira con IA (open source)' },
    ],
  },
];
---
<BaseLayout title="/uses" description="El setup y las herramientas con las que construyo y grabo.">
  <section class="container-site uses">
    <header class="uses__head">
      <p class="kicker">uses</p>
      <h1 class="uses__title">Con qué construyo</h1>
      <p class="uses__intro">
        El setup con el que programo, grabo y edito. Cambia seguido, pero esto es lo que
        uso hoy.
      </p>
    </header>

    <div class="uses__groups">
      {
        groups.map((g) => (
          <section class="ugroup reveal">
            <p class="kicker ugroup__kicker">{g.title}</p>
            <ul class="ugroup__list">
              {g.items.map((it) => (
                <li class="uitem">
                  <span class="uitem__name">{it.name}</span>
                  <span class="uitem__note">{it.note}</span>
                </li>
              ))}
            </ul>
          </section>
        ))
      }
    </div>
  </section>
</BaseLayout>

<style>
  .uses {
    padding-block: 3.5rem 2rem;
  }
  .uses__title {
    font-size: clamp(2.6rem, 6vw, 4rem);
    font-weight: 700;
    letter-spacing: -0.02em;
    margin: 0.5rem 0 1rem;
  }
  .uses__intro {
    color: var(--color-muted);
    font-size: 1.25rem;
    max-width: 52ch;
  }
  .uses__groups {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 2.5rem 3rem;
    margin-top: 3rem;
  }
  .ugroup__kicker {
    margin-bottom: 1.1rem;
  }
  .ugroup__list {
    list-style: none;
    margin: 0;
    padding: 0;
    border-top: 1px solid var(--color-border);
  }
  .uitem {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
    padding: 1rem 0;
    border-bottom: 1px solid var(--color-border);
  }
  .uitem__name {
    font-weight: 600;
  }
  .uitem__note {
    font-family: var(--font-mono);
    font-size: 0.82rem;
    color: var(--color-muted);
  }
  @media (max-width: 46rem) {
    .uses__groups {
      grid-template-columns: 1fr;
    }
  }
</style>
