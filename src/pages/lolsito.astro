</style>

<script>
  // La Grieta del hero. Vive en su propio módulo porque arrastra three.js:
  // así solo se descarga en esta página y no en el resto del sitio.
  import { montarGrieta } from '../lib/lolsito-grieta';

  let apagar: (() => void) | null = null;

  async function init() {
    apagar?.();
    apagar = null;
    const canvas = document.querySelector<HTMLCanvasElement>('canvas[data-grieta]');
    if (!canvas) return;
    apagar = await montarGrieta({
      canvas,
      voz: document.querySelector<HTMLElement>('[data-grieta-voz]'),
      reloj: document.querySelector<HTMLElement>('[data-grieta-reloj]'),
      minuto: document.querySelector<HTMLElement>('[data-grieta-min]'),
    });
  }

  document.addEventListener('astro:page-load', init);
  document.addEventListener('astro:before-swap', () => {
    apagar?.();
    apagar = null;
  });
</script>
