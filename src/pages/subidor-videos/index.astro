---
// Página pública de subidor-videos, la herramienta interna con la que Rodrigo sube
// sus propios videos a sus canales de YouTube por la YouTube Data API.
// Google la pide para la auditoría de YouTube API Services y para publicar la app
// de OAuth: página de inicio con liga a privacidad y términos, y marca de YouTube.
// En inglés porque la revisa el equipo de YouTube.
import BaseLayout from '../../layouts/BaseLayout.astro';

const CONTACT = 'itic.rodrigomg@gmail.com';
---

<BaseLayout
  title="subidor-videos"
  description="Private tool that uploads Rodrigo Méndez's own videos to his YouTube channels using YouTube API Services."
>
  <section class="container-site legal">
    <header>
      <p class="kicker">subidor-videos</p>
      <h1>subidor-videos</h1>
      <p class="lead">
        A private command line tool that uploads my own videos to the YouTube channels I
        own. It runs only on my computer, it has no other users and it is not sold or
        distributed.
      </p>
    </header>

    <a class="yt-badge" href="https://www.youtube.com" target="_blank" rel="noopener">
      <svg viewBox="0 0 28 20" width="42" height="30" aria-hidden="true">
        <path
          fill="#FF0000"
          d="M27.4 3.1A3.5 3.5 0 0 0 24.9.6C22.7 0 14 0 14 0S5.3 0 3.1.6A3.5 3.5 0 0 0 .6 3.1C0 5.3 0 10 0 10s0 4.7.6 6.9a3.5 3.5 0 0 0 2.5 2.5C5.3 20 14 20 14 20s8.7 0 10.9-.6a3.5 3.5 0 0 0 2.5-2.5C28 14.7 28 10 28 10s0-4.7-.6-6.9Z"
        ></path>
        <path fill="#FFFFFF" d="M11.2 14.3 18.5 10l-7.3-4.3v8.6Z"></path>
      </svg>
      <span>Uses YouTube API Services</span>
    </a>

    <h2>What it does</h2>
    <ul>
      <li>Uploads a video file that I produced and approved to one of my channels, with its title, description, tags, category, privacy and optional publish date.</li>
      <li>Optionally sets the video's custom thumbnail.</li>
      <li>Before every upload, confirms that the stored authorization still belongs to the expected channel.</li>
      <li>Declares every video as not made for kids, and discloses realistic AI generated content when it applies.</li>
    </ul>

    <h2>Channels</h2>
    <ul>
      <li><a href="https://www.youtube.com/@piclinkmx" target="_blank" rel="noopener">Piclink (@piclinkmx)</a></li>
      <li><a href="https://www.youtube.com/@rodrigomendezdev" target="_blank" rel="noopener">Rodrigo Méndez (@rodrigomendezdev)</a></li>
      <li><a href="https://www.youtube.com/@imgoodguy404" target="_blank" rel="noopener">imgoodguy (@imgoodguy404)</a></li>
    </ul>

    <h2>YouTube API Services</h2>
    <p>
      subidor-videos uses YouTube API Services (YouTube Data API v3) only to upload videos
      and thumbnails to the channels listed above and to read the basic information of the
      authorized channel. By using subidor-videos you agree to be bound by the
      <a href="https://www.youtube.com/t/terms" target="_blank" rel="noopener">YouTube Terms of Service</a>.
      Google's handling of data is described in the
      <a href="https://policies.google.com/privacy" target="_blank" rel="noopener">Google Privacy Policy</a>.
    </p>

    <nav class="legal-links" aria-label="Legal">
      <a href="/subidor-videos/privacy">Privacy Policy</a>
      <a href="/subidor-videos/terms">Terms of Service</a>
      <a href={`mailto:${CONTACT}`}>Contact</a>
    </nav>

    <p class="muted">
      Operated by Rodrigo Ricardo Méndez Gallegos, Jalisco, Mexico.
    </p>
  </section>
</BaseLayout>

<style>
  .legal {
    max-width: 46rem;
    padding-block: 3.5rem 4rem;
  }
  .legal h1 {
    font-size: 2rem;
    line-height: 1.2;
    margin: 0.4rem 0 0.6rem;
  }
  .legal h2 {
    font-size: 1.15rem;
    margin: 2rem 0 0.6rem;
  }
  .legal p,
  .legal li {
    line-height: 1.65;
  }
  .legal ul {
    padding-left: 1.2rem;
  }
  .legal li + li {
    margin-top: 0.35rem;
  }
  .lead {
    font-size: 1.1rem;
  }
  .yt-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.7rem;
    margin-top: 1.4rem;
    padding: 0.6rem 1rem;
    border: 1px solid var(--color-border);
    border-radius: 0.6rem;
    text-decoration: none;
    font-weight: 600;
  }
  .legal-links {
    display: flex;
    flex-wrap: wrap;
    gap: 1.5rem;
    margin: 2.5rem 0 1rem;
    font-weight: 600;
  }
  .muted {
    color: var(--color-muted);
    font-size: 0.9rem;
  }
</style>
