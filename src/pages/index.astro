---
import BaseLayout from '../layouts/BaseLayout.astro';
import CodeCard from '../components/CodeCard.astro';
import PostRow from '../components/PostRow.astro';
import VideoCard from '../components/VideoCard.astro';
import ContactForm from '../components/ContactForm.astro';
import { AUTHOR, SITE, SOCIALS, STACK } from '../consts';
import { getPublishedPosts } from '../lib/blog';
import videosData from '../data/videos.json';

const posts = await getPublishedPosts();
const latest = posts.slice(0, 3);
const videos = videosData.slice(0, 6);

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Person',
      '@id': `${SITE.url}/#rodrigo`,
      name: AUTHOR.name,
      url: SITE.url,
      image: new URL(AUTHOR.photo, SITE.url).href,
      jobTitle: AUTHOR.role,
      description: AUTHOR.oneLiner,
      homeLocation: { '@type': 'Place', name: AUTHOR.location },
      sameAs: [SOCIALS.youtube, SOCIALS.github, SOCIALS.instagram, SOCIALS.tiktok],
    },
    {
      '@type': 'WebSite',
      '@id': `${SITE.url}/#website`,
      url: SITE.url,
      name: SITE.title,
      description: SITE.description,
      inLanguage: SITE.lang,
      publisher: { '@id': `${SITE.url}/#rodrigo` },
    },
  ],
};
---
<BaseLayout jsonLd={jsonLd}>
  <!-- HERO -->
  <section class="hero container-site">
    <div class="hero__text">
      <p class="kicker kicker--accent hero__kicker">FULLSTACK PRODUCT DEVELOPER</p>
      <h1 class="hero__name">Rodrigo Méndez</h1>
      <p class="hero__lead">{AUTHOR.oneLiner}</p>
      <div class="hero__cta">
        <a href={SOCIALS.youtube} class="btn-accent" target="_blank" rel="noopener">
          Suscríbete en YouTube
        </a>
        <a href="/blog" class="btn-outline">Lee el blog</a>
      </div>
      <p class="hero__meta meta">
        {AUTHOR.location} <span class="sep">|</span> +<span data-countup={AUTHOR.years}>{AUTHOR.years}</span> años construyendo
        <span class="sep">|</span> <span class="tag">{AUTHOR.handle}</span>
      </p>
    </div>
    <div class="hero__card reveal">
      <CodeCard />
    </div>
  </section>

  <!-- SOBRE MÍ -->
  <section id="sobre" class="section container-site">
    <p class="kicker">sobre-mi</p>
    <div class="about reveal">
      <div class="about__photo placeholder-stripes">
        <img
          src={AUTHOR.photo}
          alt="Rodrigo Méndez"
          width="900"
          height="1125"
          loading="eager"
          fetchpriority="high"
          decoding="async"
        />
      </div>
      <div class="about__text">
        <h2 class="about__title">Once años escribiendo código. Y contando el proceso.</h2>
        <p>
          Empecé copiando tutoriales y rompiendo cosas. Hoy sigo rompiendo cosas, pero las
          documento. Construyo <strong>Piclink</strong> y comparto cada decisión: las buenas y
          las vergonzosas.
        </p>
        <p>
          Lo explico <span class="accent">de manera fácil</span>: como se lo contaría a un amigo
          que también está construyendo su producto a las 11 de la noche.
        </p>
      </div>
    </div>
  </section>

  <!-- STACK -->
  <section class="section container-site">
    <p class="kicker">stack</p>
    <div class="stack reveal reveal--stagger">
      {STACK.map((s, i) => <span class="chip" style={`--d:${i * 45}ms`}>{s}</span>)}
    </div>
  </section>

  <!-- BLOG -->
  <section class="section container-site">
    <div class="section__head">
      <p class="kicker">blog — últimos posts</p>
      <a href="/blog" class="section__more">ver todos <span aria-hidden="true">→</span></a>
    </div>
    <div class="rows">
      {latest.map((post) => <PostRow post={post} />)}
    </div>
  </section>

  <!-- VIDEOS -->
  {
    videos.length > 0 && (
      <section id="videos" class="section container-site">
        <div class="section__head">
          <p class="kicker">videos</p>
          <a href={SOCIALS.youtube} class="section__more" target="_blank" rel="noopener">
            ver el canal <span aria-hidden="true">→</span>
          </a>
        </div>
        <div class="videos reveal reveal--stagger">
          {videos.map((v, i) => (
            <VideoCard
              title={v.title}
              duration={v.duration}
              url={v.url}
              thumb={v.thumbnail}
              description={v.description}
              delayMs={i * 70}
            />
          ))}
        </div>
      </section>
    )
  }

  <!-- CONTACTO -->
  <section id="contacto" class="section container-site contact">
    <p class="kicker">contacto</p>
    <h2 class="contact__title">¿Construyes algo? Escríbeme.</h2>
    <p class="contact__lead">Respondo mejor por correo o X. Si es sobre colaboraciones, mejor aún.</p>

    <div class="contact__news">
      <ContactForm />
    </div>
    <p class="contact__or">o escríbeme directo</p>

    <div class="terminal reveal">
      <p class="terminal__cmd"><span class="terminal__prompt">$</span> echo $EMAIL<span class="terminal__cursor" aria-hidden="true"></span></p>
      <p class="terminal__out">
        <a href={`mailto:${AUTHOR.email}`} class="contact__email">{AUTHOR.email}</a>
        <button class="copy-btn" type="button" data-copy-email={AUTHOR.email} aria-label="Copiar correo">
          copiar
        </button>
      </p>
    </div>
    <div class="contact__socials">
      <a href={SOCIALS.youtube} class="chip" target="_blank" rel="noopener">YouTube</a>
      <a href={SOCIALS.instagram} class="chip" target="_blank" rel="noopener">Instagram</a>
      <a href={SOCIALS.tiktok} class="chip" target="_blank" rel="noopener">TikTok</a>
    </div>
  </section>
</BaseLayout>

<style>
  .section {
    padding-block: 4rem;
  }
  .section__head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
    margin-bottom: 0.5rem;
  }
  .section__more {
    font-family: var(--font-mono);
    font-size: 1rem;
    color: var(--color-accent);
  }
  .section__more:hover {
    color: var(--color-accent-deep);
  }
  .accent { color: var(--color-accent); }

  /* Hero */
  .hero {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 4rem;
    align-items: center;
    padding-block: 5.5rem 4rem;
  }
  /* Permite que las columnas se encojan: el code-card hace scroll interno,
     no empuja el ancho de la página (evita overflow horizontal en mobile). */
  .hero__text,
  .hero__card {
    min-width: 0;
  }
  .hero__kicker {
    font-size: 1.1rem;
    margin-bottom: 1.75rem;
  }
  .hero__name {
    font-size: clamp(2.8rem, 5.4vw, 5.4rem);
    font-weight: 700;
    line-height: 1;
    letter-spacing: -0.035em;
    white-space: nowrap;
  }
  .hero__name::after {
    content: "";
    display: inline-block;
    width: 0.055em;
    height: 0.8em;
    margin-left: 0.14em;
    border-radius: 2px;
    background: var(--color-accent);
    vertical-align: -0.02em;
    animation: cc-blink 1.05s step-end infinite;
  }
  .hero__lead {
    font-size: 1.5rem;
    line-height: 1.55;
    color: var(--color-muted);
    max-width: 34ch;
    margin-top: 1.75rem;
  }
  .hero__cta {
    display: flex;
    gap: 1rem;
    flex-wrap: wrap;
    margin-top: 2.25rem;
  }
  .hero__cta :global(.btn-accent),
  .hero__cta :global(.btn-outline) {
    font-size: 1.05rem;
    padding: 0.85rem 1.7rem;
  }
  .hero__meta {
    font-size: 0.95rem;
    margin-top: 2.75rem;
  }
  .hero__meta .sep {
    color: var(--color-border);
    margin-inline: 0.5rem;
  }

  /* About */
  .about {
    display: grid;
    grid-template-columns: 280px 1fr;
    gap: 3rem;
    align-items: start;
    margin-top: 1.75rem;
  }
  .about__photo {
    border-radius: 16px;
    overflow: hidden;
    aspect-ratio: 4 / 5;
  }
  .about__photo img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .about__title {
    font-size: clamp(2.1rem, 3.8vw, 3.3rem);
    font-weight: 700;
    letter-spacing: -0.02em;
    line-height: 1.1;
    margin-bottom: 1.75rem;
  }
  .about__text p {
    color: var(--color-muted);
    font-size: 1.22rem;
    line-height: 1.7;
    max-width: 62ch;
    margin-bottom: 1.15rem;
  }
  .about__text strong {
    color: var(--color-ink);
    font-weight: 600;
  }

  /* Stack */
  .stack {
    display: flex;
    flex-wrap: wrap;
    gap: 0.9rem;
    margin-top: 1.5rem;
  }

  /* Blog rows */
  .rows {
    margin-top: 1rem;
    border-bottom: 1px solid var(--color-border);
  }

  /* Videos */
  .videos {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.75rem;
    margin-top: 1.75rem;
  }

  /* Contact */
  .contact {
    text-align: center;
    padding-block: 5rem;
  }
  .contact .kicker::before,
  .contact .kicker {
    display: inline-block;
  }
  .contact__title {
    font-size: clamp(2.3rem, 5vw, 3.9rem);
    font-weight: 700;
    letter-spacing: -0.02em;
    margin: 1.25rem 0 1rem;
  }
  .contact__lead {
    color: var(--color-muted);
    font-size: 1.15rem;
    max-width: 46ch;
    margin: 0 auto 2rem;
  }
  .contact__news {
    margin-bottom: 2.25rem;
  }
  .contact__or {
    font-family: var(--font-mono);
    font-size: 0.8rem;
    color: var(--color-faint);
    margin-bottom: 1.1rem;
  }

  /* Contacto tipo terminal: $ echo $EMAIL */
  .terminal {
    max-width: 30rem;
    margin: 0 auto;
    text-align: left;
    border: 1px solid var(--color-border);
    border-radius: 12px;
    background: var(--color-surface);
    padding: 1.1rem 1.3rem;
    font-family: var(--font-mono);
    box-shadow: 0 20px 60px -34px rgba(0, 0, 0, 0.8);
  }
  .terminal__cmd {
    color: var(--color-muted);
    font-size: 0.95rem;
  }
  .terminal__prompt {
    color: var(--color-accent);
    margin-right: 0.4rem;
  }
  .terminal__cursor {
    display: inline-block;
    width: 0.55ch;
    height: 1.05em;
    margin-left: 0.15rem;
    vertical-align: -0.18em;
    background: var(--color-accent);
    animation: cc-blink 1.05s step-end infinite;
  }
  .terminal__out {
    display: flex;
    align-items: center;
    gap: 0.9rem;
    flex-wrap: wrap;
    margin-top: 0.7rem;
    opacity: 0;
  }
  .reveal.is-visible .terminal__out {
    animation: term-print 0.45s ease 0.35s forwards;
  }
  @media (prefers-reduced-motion: reduce) {
    .terminal__out { opacity: 1; animation: none; }
  }
  @keyframes term-print {
    from { opacity: 0; transform: translateY(3px); }
    to { opacity: 1; transform: none; }
  }
  .contact__email {
    font-family: var(--font-mono);
    font-size: clamp(1.05rem, 2.2vw, 1.45rem);
    color: var(--color-accent);
  }
  .contact__email:hover {
    color: var(--color-accent-deep);
  }
  .contact__socials {
    display: flex;
    flex-wrap: wrap;
    gap: 0.9rem;
    justify-content: center;
    margin-top: 2.25rem;
  }

  @media (max-width: 52rem) {
    .hero {
      grid-template-columns: minmax(0, 1fr);
      gap: 2.5rem;
      padding-block: 3.5rem 2.5rem;
    }
    .hero__name {
      white-space: normal;
      font-size: clamp(2.6rem, 13vw, 4rem);
    }
    .about {
      grid-template-columns: minmax(0, 1fr);
      gap: 1.75rem;
    }
    .about__photo {
      max-width: 240px;
    }
    .videos {
      grid-template-columns: minmax(0, 1fr);
    }
  }

  @media (max-width: 40rem) {
    .section {
      padding-block: 3rem;
    }
    .section__head {
      flex-wrap: wrap;
      align-items: baseline;
      gap: 0.35rem 1rem;
    }
    .section__more {
      font-size: 0.9rem;
    }
    .hero {
      padding-block: 2.5rem 2rem;
      gap: 2rem;
    }
    .hero__kicker {
      font-size: 0.95rem;
      margin-bottom: 1.1rem;
    }
    .hero__lead {
      font-size: 1.2rem;
      margin-top: 1.25rem;
    }
    .hero__cta {
      margin-top: 1.75rem;
      gap: 0.75rem;
    }
    .hero__cta :global(.btn-accent),
    .hero__cta :global(.btn-outline) {
      font-size: 0.98rem;
      padding: 0.75rem 1.35rem;
    }
    .hero__meta {
      font-size: 0.85rem;
      margin-top: 2rem;
    }
    .hero__meta .sep {
      margin-inline: 0.35rem;
    }
    .about__title {
      font-size: 1.9rem;
      margin-bottom: 1.1rem;
    }
    .about__text p {
      font-size: 1.08rem;
    }
    .videos {
      gap: 1.5rem;
    }
    .contact {
      padding-block: 3.5rem;
    }
    .contact__lead {
      font-size: 1.05rem;
    }
    .terminal {
      padding: 1rem;
    }
    .contact__email {
      overflow-wrap: anywhere;
    }
  }
</style>
