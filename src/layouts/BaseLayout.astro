---
import '@fontsource-variable/outfit';
import '@fontsource/jetbrains-mono/400.css';
import '@fontsource/jetbrains-mono/500.css';
import '@fontsource/jetbrains-mono/700.css';
import '../styles/global.css';

import { ClientRouter } from 'astro:transitions';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import CommandPalette from '../components/CommandPalette.astro';
import { SITE } from '../consts';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  type?: 'website' | 'article';
  publishedTime?: string;
  jsonLd?: Record<string, unknown>;
  noNav?: boolean;
}

const {
  title,
  description = SITE.description,
  image = '/og-default.png',
  type = 'website',
  publishedTime,
  jsonLd,
  noNav = false,
} = Astro.props;

const pageTitle = title ? `${title} — ${SITE.title}` : `${SITE.title} — ${SITE.tagline}`;
const canonical = new URL(Astro.url.pathname, SITE.url).href;
const ogImage = new URL(image, SITE.url).href;
---
<!doctype html>
<html lang={SITE.lang}>
  <head>
    <script is:inline>
      document.documentElement.classList.add('js');
      console.log(
        '%c</> hola, curioso.',
        'color:#37D5E7;font:700 20px ui-monospace,monospace'
      );
      console.log(
        '%c¿husmeando el código? escríbeme: hola@rodrigomendez.dev  ·  tip: teclea "dev"',
        'color:#8a93a6;font:13px ui-monospace,monospace'
      );
    </script>
    <ClientRouter />
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link rel="alternate" type="application/rss+xml" title={SITE.title} href="/rss.xml" />
    <link rel="canonical" href={canonical} />

    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <meta name="author" content="Rodrigo Méndez" />

    <meta property="og:type" content={type} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:locale" content={SITE.locale} />
    <meta property="og:site_name" content={SITE.title} />
    {publishedTime && <meta property="article:published_time" content={publishedTime} />}

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <meta name="theme-color" content="#0B0E14" />

    {
      jsonLd && (
        <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
      )
    }
  </head>
  <body>
    {!noNav && <Nav transition:persist />}
    <main id="contenido">
      <slot />
    </main>
    <Footer transition:persist />
    <CommandPalette transition:persist />

    <script>
      // Reveal on scroll (respeta prefers-reduced-motion vía CSS).
      function initReveal() {
        const els = Array.from(document.querySelectorAll('.reveal'));
        if (!els.length) return;
        const io = new IntersectionObserver(
          (entries, obs) => {
            for (const e of entries) {
              if (e.isIntersecting) {
                e.target.classList.add('is-visible');
                obs.unobserve(e.target);
              }
            }
          },
          { rootMargin: '0px 0px -8% 0px' }
        );
        // Revela lo que ya está en pantalla o quedó por encima del viewport
        // (p.ej. cuando un refresh restaura el scroll); observa lo que sigue abajo.
        const settle = () => {
          for (const el of els) {
            if (el.classList.contains('is-visible')) continue;
            if (el.getBoundingClientRect().top < window.innerHeight * 0.95) {
              el.classList.add('is-visible');
              io.unobserve(el);
            } else {
              io.observe(el);
            }
          }
        };
        settle();
        requestAnimationFrame(settle);
      }

      // Copiar el correo con feedback "copiado ✓".
      function initCopyEmail() {
        const btn = document.querySelector('[data-copy-email]') as HTMLButtonElement | null;
        if (!btn || btn.dataset.bound) return;
        btn.dataset.bound = '1';
        const original = btn.textContent;
        btn.addEventListener('click', async () => {
          try {
            await navigator.clipboard.writeText(btn.dataset.copyEmail || '');
            btn.textContent = 'copiado ✓';
            btn.classList.add('is-copied');
            setTimeout(() => {
              btn.textContent = original;
              btn.classList.remove('is-copied');
            }, 1600);
          } catch {}
        });
      }

      // Count-up de números marcados con data-countup (ej. "+11 años").
      function initCountUp() {
        const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
        const els = Array.from(document.querySelectorAll('[data-countup]')) as HTMLElement[];
        for (const el of els) {
          if (el.dataset.done) continue;
          const target = parseInt(el.dataset.countup || '0', 10);
          if (reduce) { el.textContent = String(target); el.dataset.done = '1'; continue; }
          const io = new IntersectionObserver((entries, obs) => {
            if (!entries[0].isIntersecting) return;
            obs.disconnect();
            el.dataset.done = '1';
            const dur = 950;
            const start = performance.now();
            const tick = (now: number) => {
              const t = Math.min(1, (now - start) / dur);
              const eased = 1 - Math.pow(1 - t, 3);
              el.textContent = String(Math.round(eased * target));
              if (t < 1) requestAnimationFrame(tick);
              else el.textContent = String(target);
            };
            requestAnimationFrame(tick);
          }, { threshold: 1 });
          io.observe(el);
        }
      }

      // Decode/scramble de los kickers "// texto" al entrar en viewport.
      function initKickerScramble() {
        if (matchMedia('(prefers-reduced-motion: reduce)').matches) return;
        const glyphs = '!<>-_\\/[]{}=+*^?#01x';
        const els = Array.from(document.querySelectorAll('.kicker')) as HTMLElement[];
        for (const el of els) {
          if (el.dataset.scrambled) continue;
          const io = new IntersectionObserver((entries, obs) => {
            if (!entries[0].isIntersecting) return;
            obs.disconnect();
            el.dataset.scrambled = '1';
            const final = el.textContent || '';
            let frame = 0;
            const total = final.length * 1.25 + 16;
            const anim = () => {
              let out = '';
              for (let i = 0; i < final.length; i++) {
                if (final[i] === ' ') { out += ' '; continue; }
                out += frame > i * 1.25 + 4 ? final[i] : glyphs[Math.floor(Math.random() * glyphs.length)];
              }
              el.textContent = out;
              if (frame++ <= total) requestAnimationFrame(anim);
              else el.textContent = final;
            };
            anim();
          }, { threshold: 0.6 });
          io.observe(el);
        }
      }

      // Se re-ejecutan en cada navegación (View Transitions).
      document.addEventListener('astro:page-load', () => {
        initReveal();
        initCopyEmail();
        initCountUp();
        initKickerScramble();
      });

      // --- Easter egg: teclea "dev" → lluvia de símbolos de código ---
      const reduceMotion = matchMedia('(prefers-reduced-motion: reduce)').matches;
      let buf = '';
      document.addEventListener('keydown', (e) => {
        if ((e.target as HTMLElement)?.matches?.('input,textarea')) return;
        if (e.key.length !== 1) return;
        buf = (buf + e.key.toLowerCase()).slice(-3);
        if (buf === 'dev') {
          buf = '';
          codeRain();
        }
      });
      let raining = false;
      function codeRain() {
        if (raining || reduceMotion) return;
        raining = true;
        const glyphs = ['</>', '{', '}', '=>', '()', ';', '[]', '&&', 'const', '<Profile/>', '//', '{...}'];
        const layer = document.createElement('div');
        layer.className = 'coderain';
        document.body.appendChild(layer);
        const n = 34;
        for (let i = 0; i < n; i++) {
          const s = document.createElement('span');
          s.textContent = glyphs[i % glyphs.length];
          s.style.left = Math.random() * 100 + 'vw';
          s.style.animationDuration = 2.4 + Math.random() * 2.6 + 's';
          s.style.animationDelay = Math.random() * 1.2 + 's';
          s.style.fontSize = 0.8 + Math.random() * 1.1 + 'rem';
          s.style.opacity = String(0.35 + Math.random() * 0.55);
          layer.appendChild(s);
        }
        setTimeout(() => { layer.remove(); raining = false; }, 6000);
      }
    </script>
  </body>
</html>
